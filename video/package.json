{
  "name": "field-shift-video",
  "version": "0.1.0",
  "private": true,
  "description": "Field Shift \u2014 30 s NASA Space Apps demo video: Playwright films the live platform, Remotion composites it.",
  "scripts": {
    "capture": "node capture/tour.mjs && node capture/ui-shots.mjs",
    "studio": "remotion studio",
    "render": "remotion render FieldShift out/field-shift.mp4 && node scripts/tidy-duration.mjs out/field-shift.mp4",
    "fonts": "node scripts/copy-fonts.mjs",
    "postinstall": "node scripts/copy-fonts.mjs",
    "typecheck": "tsc --noEmit",
    "voiceover": "node --experimental-strip-types audio/build-voiceover.mjs",
    "shots": "node capture/ui-shots.mjs",
    "voiceover:tts": "node --experimental-strip-types audio/tts.mjs",
    "voiceover:tts:chatterbox": "node --experimental-strip-types audio/tts-chatterbox.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "@remotion/fonts": "4.0.543",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "playwright": "1.63.0",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
